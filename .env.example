# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only — used by the GitHub push webhook to write history. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Any long random string; paste the same value into the GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=

# Lets the hub create the season repo (rec-robocon2026/RC26) and commit robot/module folders.
# Fine-grained token: Resource owner = the org, All repositories,
# permissions Administration + Contents + Webhooks = Read and write.
GITHUB_TOKEN=
GITHUB_ORG=rec-robocon2026
# private (default) or public. Protecting main on a private repo needs a paid GitHub plan.
GITHUB_REPO_VISIBILITY=private
# The production URL, used for the webhook the hub installs.
SITE_URL=https://hub-wus5.vercel.app
